# ============================================================================
# Configuración de entorno para Control de Combustible y Gastos de Vehículos
# Si no se define .env propio en producción, carga automáticamente el .env
# de Moratalla-Murcia-2026 cuando se despliega en /combustible.
# ============================================================================

APP_ENV=local

# Conexión MySQL / MariaDB (XAMPP local por defecto)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=moratalla_web_2026
